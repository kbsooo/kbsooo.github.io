---
// Where to find the person: each name with its address under it.
import { contacts } from "../data/site";

const external = { target: "_blank", rel: "noreferrer" };

// An address breaks only after a slash, never inside a part of it.
const parts = (handle: string) => {
  const pieces = handle.split("/");
  return pieces.map((piece, index) => (index < pieces.length - 1 ? `${piece}/` : piece));
};
---

<ul class="contacts">
  {
    contacts.map(({ label, handle, href }) => (
      <li>
        <a href={href} {...(href.startsWith("mailto:") ? {} : external)}>
          <span class="contacts__label">{label}</span>
          {/* prettier-ignore */}
          <span class="contacts__handle">{parts(handle).map((part) => <><span>{part}</span><wbr /></>)}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* One column for each name. When the row is too narrow, the short addresses
     keep their width and the longest one breaks. */
  .contacts {
    display: grid;
    grid-auto-columns: minmax(0, max-content);
    grid-auto-flow: column;
    justify-content: start;
    gap: 1.25rem clamp(1.5rem, 4vw, 4rem);
  }

  .contacts a {
    display: block;
    text-decoration: none;
  }

  .contacts__label {
    display: block;
    font-family: var(--font-narrow);
    font-size: clamp(2rem, 3.4vw, 3.25rem);
    font-weight: 1000;
    line-height: 0.95;
    letter-spacing: -0.005em;
  }

  .contacts a:hover .contacts__label {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .contacts__handle {
    display: block;
    margin-top: 0.4rem;
  }

  .contacts__handle span {
    white-space: nowrap;
  }

  @media (max-width: 47.99rem) {
    .contacts {
      grid-auto-flow: row;
    }
  }
</style>

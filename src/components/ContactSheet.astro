---
// The red sheet: where to find the person, and at its foot a moving scene.
// The sheet is the sky of that scene: the links stand in it, the land lies
// along the bottom edge.
import ContactLinks from "./ContactLinks.astro";
import ContactScene from "./ContactScene.astro";
import { scene } from "../data/scene";

interface Props {
  /** The sheet closes a page: it is then at least as tall as the window, and
      the layout script (BaseLayout) knows it by `data-closing`. */
  closing?: boolean;
}

const { closing = false } = Astro.props;
---

<section class="sheet contact" data-tone="red" data-closing={closing || undefined} aria-label="Contact">
  <div class="contact__head">
    <ContactLinks />
    <p>
      {scene.maker}
      <br />
      <a href={scene.href} target="_blank" rel="noreferrer">{scene.name}</a>
      <br />
      {scene.library}, <a href={scene.licence}>MIT licence</a>
    </p>
  </div>
  <ContactScene />
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    padding-bottom: 0;
  }

  /* As tall as the window with the browser's bars away, which is how a phone
     shows the end of a page: the last screen is then this sheet alone. */
  .contact[data-closing] {
    min-height: 100vh;
  }

  /* The links, and beside them the label of the scene; under them where the
     sheet is too narrow for both. */
  .contact__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem var(--gutter);
    margin-bottom: clamp(2.5rem, 7vw, 6rem);
  }

  @media (min-width: 60rem) {
    .contact__head {
      grid-template-columns: var(--columns);
    }
  }
</style>

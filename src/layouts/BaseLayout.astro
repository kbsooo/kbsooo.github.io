---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  ogImage?: string;
}

const {
  title = "KBSOO",
  description = "Notes on machine learning, agent systems, and applied research.",
  pageClass = "",
  ogImage = "",
} = Astro.props;

const currentPath = Astro.url.pathname;
const isArticles = currentPath.startsWith("/posts");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <nav class="site-nav">
      <a class="site-nav__brand" href="/">KBSOO</a>
      <div class="site-nav__links">
        <a href="/posts/" class:list={[{ "is-active": isArticles }]}>Articles</a>
        <a href="https://kbsooo.github.io/culture/">Culture</a>
        <a href="https://github.com/kbsooo" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </nav>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>

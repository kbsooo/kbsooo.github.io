---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  ogImage?: string;
}

const {
  title = "KBSOO",
  description = "Writing about machine intelligence, systems, and technical thinking.",
  pageClass = "",
  ogImage = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&family=Noto+Serif+KR:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <a class="site-wordmark" href="/">
        <span>KBSOO</span>
        <span>Machine Intelligence Notes</span>
      </a>
    </header>
    <footer class="site-credit">
      <span>&copy; 2026 Byungsoo Kang</span>
    </footer>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>

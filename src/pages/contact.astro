---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Contact | ${site.brand}`}
  description={`Where to find ${site.name}.`}
  contact={false}
>
  <section class="head">
    <h1 class="display">Contact</h1>
  </section>

  <section class="sheet contact" data-tone="red">
    <ContactLinks handles />
  </section>
</BaseLayout>

<style>
  /* The red sheet runs to the bottom of the window, with the links at its foot. */
  .contact {
    display: grid;
    flex: 1 0 auto;
    align-content: end;
    min-height: 45vh;
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dedupeTranslations, formatDate, getPostPath, inferLanguage, sortPostsPreferKo } from "../../lib/content";

const posts = dedupeTranslations(
  sortPostsPreferKo(await getCollection("posts", ({ data }) => !data.draft)),
);
---

<BaseLayout
  title="Articles | KBSOO"
  description="All essays and notes by Byungsoo Kang."
  pageClass="page--posts"
>
  <section class="posts-hero">
    <h1>Articles</h1>
    <p class="posts-hero__desc">
      Essays, technical notes, and translated research across AI, databases,
      recommendation systems, and experiments.
    </p>
  </section>

  <div class="post-list">
    {posts.map((post) => (
      <a class="post-card" href={getPostPath(post)}>
        <div>
          <strong class="post-card__title">{post.data.title}</strong>
          <p class="post-card__desc">
            {post.data.description || "Technical reflections and working notes."}
          </p>
        </div>
        <div class="post-card__meta">
          <span>{formatDate(post.data.date)}</span>
          <span>{inferLanguage(post)}</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

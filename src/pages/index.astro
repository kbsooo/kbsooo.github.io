---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatDate,
  getPostPath,
  inferLanguage,
  sortPosts,
} from "../lib/content";

const posts = sortPosts(
  await getCollection("posts", ({ data }) => !data.draft),
);
const featured = posts.slice(0, 6);
const marqueeItems = [
  "LLM Systems",
  "Recommendation",
  "Databases",
  "Machine Learning",
  "Essays",
  "Korean / English",
  "Technical Notes",
];
---

<BaseLayout
  title="KBSOO"
  description="Editorial notes on AI, LLM systems, databases, and platform strategy."
  pageClass="page--home"
>
  <!-- Hero: full viewport, centered, accent-red title -->
  <section class="section-fullvp home-hero">
    <p class="eyebrow">Byungsoo Kang, Seoul</p>
    <h1>
      AI,<br />
      products,<br />
      and writing
    </h1>
    <p class="home-hero__sub">
      I write about how models behave, how products change incentives, and how
      technical systems shape culture.
    </p>
  </section>

  <!-- Navigation: big text links -->
  <section class="section-fullvp home-nav">
    <a href="/posts/">Articles</a>
    <a href="https://kbsooo.github.io/culture/">Culture</a>
    <a href="https://github.com/kbsooo" target="_blank" rel="noreferrer">GitHub</a>
    <a href="https://www.linkedin.com/in/byungsoo-kang-511b82342/" target="_blank" rel="noreferrer">
      LinkedIn
    </a>
  </section>

  <!-- Recent notes -->
  <section class="section-block section-block--plain">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2>Recent notes</h2>
    </div>
    <div class="editorial-list">
      {featured.map((post, index) => (
        <a class="editorial-row" href={getPostPath(post)}>
          <span class="editorial-row__index">{String(index + 1).padStart(2, "0")}</span>
          <div class="editorial-row__body">
            <strong>{post.data.title}</strong>
            <p>{post.data.description || "Technical reflections and working notes."}</p>
          </div>
          <div class="editorial-row__meta">
            <span>{formatDate(post.data.date)}</span>
            <span>{inferLanguage(post)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Marquee strip -->
  <div class="home-marquee" style="margin-top: 3rem;">
    <div class="home-marquee__track">
      {marqueeItems.concat(marqueeItems).map((item) => (
        <span class="marquee-chip">{item}</span>
      ))}
    </div>
  </div>
</BaseLayout>

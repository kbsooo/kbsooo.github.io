---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  excerptFromBody,
  formatDate,
  getPostPath,
  inferLanguage,
  readingMinutes,
  sortPosts,
} from "../lib/content";

const posts = sortPosts(
  await getCollection("posts", ({ data }) => !data.draft),
);
const featured = posts.slice(0, 6);
const leadPost = featured[0];
const recentNotes = leadPost ? posts.slice(1, 7) : featured;
const marqueeItems = [
  "LLM Systems",
  "Recommendation",
  "Databases",
  "Machine Learning",
  "Essays",
  "Korean / English",
  "Technical Notes",
];
const leadExcerpt = leadPost
  ? excerptFromBody(leadPost, 180)
  : "Technical reflections on machine intelligence, products, and systems.";
---

<BaseLayout
  title="KBSOO"
  description="Machine learning notes on agent systems, translation, multimodal modeling, and evaluation."
  pageClass="page--home"
>
  <section class="home-poster">
    <div class="home-poster__inner">
      <div class="home-poster__copy">
        <p class="eyebrow">Byungsoo Kang · ML Engineer</p>
        <h1>
          ML,<br />
          agents,<br />
          and applied research
        </h1>
        <p class="home-hero__sub">
          I work on LLM systems, translation, and multimodal modeling, and I use this space
          to document experiments, project decisions, and what I learn along the way.
        </p>
        <div class="home-poster__actions">
          <a href="/posts/">Read articles</a>
          <a href="https://kbsooo.github.io/culture/">Open culture log</a>
          <a href="https://github.com/kbsooo" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/byungsoo-kang-511b82342/" target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </div>
      </div>

      {leadPost && (
        <a class="home-poster__feature" href={getPostPath(leadPost)}>
          <span class="home-poster__feature-label">Latest note</span>
          <strong>{leadPost.data.title}</strong>
          <p>{leadPost.data.description || leadExcerpt}</p>
          <div class="home-poster__feature-meta">
            <span>{formatDate(leadPost.data.date)}</span>
            <span>{inferLanguage(leadPost)}</span>
            <span>{readingMinutes(leadPost)} min</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="home-intro">
    <p class="home-intro__kicker">Writing archive</p>
    <p class="home-intro__text">
      Notes from building ML systems: agent workflows, evaluation, model behavior,
      and the practical side of turning recent research into usable tools.
    </p>
  </section>

  <section class="section-block section-block--plain">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2>Recent notes</h2>
    </div>
    <div class="editorial-list">
      {recentNotes.map((post, index) => (
        <a class="editorial-row" href={getPostPath(post)}>
          <span class="editorial-row__index">{String(index + 1).padStart(2, "0")}</span>
          <div class="editorial-row__body">
            <strong>{post.data.title}</strong>
            <p>{post.data.description || "Technical reflections and working notes."}</p>
          </div>
          <div class="editorial-row__meta">
            <span>{formatDate(post.data.date)}</span>
            <span>{inferLanguage(post)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Marquee strip -->
  <div class="home-marquee" style="margin-top: 3rem;">
    <div class="home-marquee__track">
      {marqueeItems.concat(marqueeItems).map((item) => (
        <span class="marquee-chip">{item}</span>
      ))}
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TagPill from "../components/TagPill.astro";
import {
  formatDate,
  getPostPath,
  inferLanguage,
  normalizeTag,
  sortPosts,
} from "../lib/content";

const posts = sortPosts(
  await getCollection("posts", ({ data }) => !data.draft),
);
const featured = posts.slice(0, 6);
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 10);
const koreanCount = posts.filter((post) => inferLanguage(post) === "KR").length;
const marqueeItems = [
  "LLM Systems",
  "Recommendation",
  "Databases",
  "Machine Learning",
  "Essays",
  "Korean / English",
  "Technical Notes",
];
---

<BaseLayout
  title="KBSOO"
  description="Editorial notes on AI, LLM systems, databases, and platform strategy."
>
  <section class="home-canvas">
    <div class="home-canvas__intro">
      <p class="eyebrow">Byungsoo Kang, Seoul</p>
      <h1>
        AI,
        <br />
        products,
        <br />
        and writing
      </h1>
      <p class="hero__lede">
        I write about how models behave, how products change incentives, and how
        technical systems shape culture.
      </p>
      <p class="hero__sublede">
        Most notes begin with machine learning or recommendation systems and end
        up somewhere between product strategy, interface design, and human
        behavior.
      </p>
    </div>

    <div class="home-canvas__links">
      <a href="/posts/">Articles</a>
      <a href="https://kbsooo.github.io/culture/">Culture</a>
      <a href="https://github.com/kbsooo" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/byungsoo-kang-511b82342/" target="_blank" rel="noreferrer">
        LinkedIn
      </a>
      <span>{posts.length} notes</span>
    </div>

    <div class="home-marquee">
      <div class="home-marquee__track">
        {marqueeItems.concat(marqueeItems).map((item) => (
          <span class="marquee-chip">{item}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="home-meta">
    <div class="home-meta__stats">
      <p><strong>{posts.length}</strong> published notes</p>
      <p><strong>{posts.length - koreanCount} English</strong> and <strong>{koreanCount} Korean</strong></p>
      <p>Topics move across LLMs, recommendation, databases, and product thinking.</p>
    </div>
    <div class="topic-cluster">
      {topics.map((topic) => <TagPill label={normalizeTag(topic)} />)}
    </div>
  </section>

  <section class="section-block section-block--plain">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2>Recent notes</h2>
    </div>
    <div class="editorial-list">
      {featured.map((post, index) => (
        <a class="editorial-row" href={getPostPath(post)}>
          <span class="editorial-row__index">{String(index + 1).padStart(2, "0")}</span>
          <div class="editorial-row__body">
            <strong>{post.data.title}</strong>
            <p>{post.data.description || "Technical reflections and working notes."}</p>
          </div>
          <div class="editorial-row__meta">
            <span>{formatDate(post.data.date)}</span>
            <span>{inferLanguage(post)}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

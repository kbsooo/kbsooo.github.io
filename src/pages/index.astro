---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlateSeries from "../components/PlateSeries.astro";
import { research, venueLine } from "../data/research";
import { site } from "../data/site";
import { countLine, seriesFor } from "../lib/plates";

// The home page hangs only the first series of each work, small.
const works = research.map((item) => ({ item, series: seriesFor(item.slug).slice(0, 1) }));
---

<BaseLayout>
  <section class="head">
    <h1 class="display">{site.name}</h1>
    <div class="head__text">
      <p>{site.bio}</p>
      <p>{site.affiliation}</p>
    </div>
  </section>

  {
    works.map(({ item, series }) => (
      <section class="sheet" data-sheet data-tone={item.tone}>
        <div class="sheet__head">
          <div class="sheet__id">
            <span class="numeral">{item.no}</span>
            <h2 class="title">
              <a href={`/research/#${item.slug}`}>{item.title}</a>
            </h2>
          </div>
          <p>
            {venueLine(item)}
            <br />
            {countLine(series)}
          </p>
        </div>
        {series.map((one) => <PlateSeries series={one} work={item.title} size="small" />)}
      </section>
    ))
  }
</BaseLayout>

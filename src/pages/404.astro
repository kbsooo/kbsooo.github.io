---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | KBSOO" description="Page not found">
  <section class="page-header surface-panel">
    <p class="eyebrow">404</p>
    <h1>The note you were looking for is not here.</h1>
    <p class="hero__lede">
      The structure changed during the redesign. Start from the writing archive
      and continue from there.
    </p>
    <div class="hero__actions">
      <a class="button button--solid" href="/">Go home</a>
      <a class="button button--ghost" href="/posts/">Open archive</a>
    </div>
  </section>
</BaseLayout>


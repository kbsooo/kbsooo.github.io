---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | KBSOO" description="Page not found" pageClass="page--404">
  <section class="not-found-hero">
    <p class="eyebrow">404</p>
    <h1>The note you were looking for is not here.</h1>
    <p>
      The structure changed during the redesign. Start from the writing archive
      and continue from there.
    </p>
    <div class="hero__actions">
      <a href="/">Go home</a>
      <a href="/posts/">Open archive</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Page not found | ${site.brand}`} description="Page not found">
  <section class="head">
    <h1 class="display">Page not found</h1>
    <div class="head__text">
      <p>
        Nothing hangs at this address. It may have moved, or the link may be wrong.
        <a href="/">Go to the first page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>print(&lt;span style="color:#e6db74">&amp;#34;test data isnull:&lt;/span>&lt;span style="color:#ae81ff">\n&lt;/span>&lt;span style="color:#e6db74">&amp;#34;&lt;/span>, test_data&lt;span style="color:#f92672">.&lt;/span>isnull()&lt;span style="color:#f92672">.&lt;/span>sum())
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>print(&lt;span style="color:#e6db74">&amp;#34;train data rainfall value_counts:&lt;/span>&lt;span style="color:#ae81ff">\n&lt;/span>&lt;span style="color:#e6db74">&amp;#34;&lt;/span>, train_data[&lt;span style="color:#e6db74">&amp;#39;rainfall&amp;#39;&lt;/span>]&lt;span style="color:#f92672">.&lt;/span>value_counts())
